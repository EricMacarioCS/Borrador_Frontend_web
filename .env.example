# Copia este archivo como .env.local para desarrollo. Nada aquí es secreto: termina en el navegador.
# En producción estos valores no se usan; el contenedor genera /config.json con variables de entorno.

# mock: backend simulado en el navegador (por defecto). http: API real.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
VITE_HUB_URL=/hubs/seats

# Con VITE_API_MODE=http, el servidor de desarrollo reenvía /api y /hubs a este backend (sin CORS).
# VITE_PROXY_TARGET=http://localhost:5080
