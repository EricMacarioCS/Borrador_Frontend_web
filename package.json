{
  "name": "cinepolis-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Borrador del sitio web público. Frontend Vue con backend simulado detrás de puertos reemplazables.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@lucide/vue": "1.78.0",
    "@microsoft/signalr": "10.0.11",
    "@tanstack/vue-query": "5.108.3",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.6",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
