{
  "name": "cinepolis-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Borrador del sitio público. Frontend React con backend simulado detrás de puertos reemplazables.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
